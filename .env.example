# --- MODE HYBRIDE (serveur Docker + Banker local MT5) ---
# Sur le serveur, BANKER_API_HOST doit pointer vers le PC local qui lance banker.bat.
BANKER_API_HOST="192.168.1.10"
BANKER_API_PORT=8100

# Univers de marche dynamique pour le banker
BANKER_DYNAMIC_UNIVERSE=true
BANKER_SCAN_FOREX=true
BANKER_SCAN_CFD=true
BANKER_SCAN_CRYPTO=true
BANKER_SCAN_BATCH_SIZE=40
BANKER_UNIVERSE_REFRESH_MINUTES=240
BANKER_UNIVERSE_MAX_SYMBOLS=0
BANKER_STARTUP_ALERT_COOLDOWN_MINUTES=20
HIVE_SERVER_HOST="192.168.1.6"
HIVE_REMOTE_DIR="/home/aza/The_Hive"
HIVE_REDIS_HOST="redis"
HIVE_QDRANT_HOST="qdrant"
HIVE_NEO4J_HOST="neo4j"
HIVE_MQTT_HOST="mosquitto"
HIVE_COMFYUI_HOST="comfyui"
HIVE_OLLAMA_HOST="host.docker.internal"
MOCK_MT5=true
PAPER_TRADING=true

# --- PROMPTS / RAG (Biblio_IA) ---
