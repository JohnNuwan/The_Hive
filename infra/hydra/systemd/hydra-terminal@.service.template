[Unit]
Description=Hydra Terminal Executor {{ACCOUNT_NAME}}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{REMOTE_REPO_DIR}}
EnvironmentFile={{ENV_FILE}}
ExecStart={{LAUNCHER}}
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=30
CPUAffinity={{CPU_SET}}

[Install]
WantedBy=default.target
